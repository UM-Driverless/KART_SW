[Unit]
Description=Kart Brain ROS2 autonomous stack
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=orin
Environment=DISPLAY=:1
Environment=XAUTHORITY=/run/user/1000/gdm/Xauthority
ExecStartPre=/bin/sleep 10
ExecStartPre=/bin/bash -c 'python3 -c "import serial; s=serial.Serial(\"/dev/ttyUSB0\", 115200); s.setDTR(False); import time; time.sleep(0.1); s.setDTR(True); time.sleep(0.5); s.close()" 2>/dev/null || true'
ExecStart=/bin/bash -c '\
  source /opt/ros/humble/setup.bash && \
  source ~/kart_brain/install/setup.bash && \
  ros2 launch kart_bringup launch.py'
ExecStop=/bin/bash -c 'pkill -f "state_machine|cmd_vel_bridge|KB_Coms_micro|dashboard_node|steering_hud|yolo_detector|cone_follower|cone_depth|steering_hud" 2>/dev/null'
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
